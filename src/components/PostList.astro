---
interface Props {
  posts: Array<{
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      tags: string[];
    };
  }>;
  limit?: number;
}

const { posts, limit } = Astro.props;
const visiblePosts = typeof limit === 'number' ? posts.slice(0, limit) : posts;
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: 'UTC',
});
---

<ol class="post-list">
  {visiblePosts.map((post, index) => (
    <li>
      <a href={`/blog/${post.id}/`}>
        <span class="post-index">{String(index + 1).padStart(2, '0')}</span>
        <span class="post-copy">
          <strong>{post.data.title}</strong>
          <span>{post.data.description}</span>
        </span>
        <span class="post-date">{dateFormatter.format(post.data.pubDate)}</span>
        <span class="post-arrow" aria-hidden="true">↗</span>
      </a>
    </li>
  ))}
</ol>
