---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['arrow-up-right', className]}
  viewBox="0 0 16 16"
  aria-hidden="true"
  focusable="false"
>
  <path d="M4 12 12 4M6 4h6v6"></path>
</svg>

<style>
  .arrow-up-right {
    display: inline-block;
    width: 0.9em;
    height: 0.9em;
    flex: 0 0 auto;
    overflow: visible;
    vertical-align: -0.08em;
    fill: none;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-linejoin: miter;
    stroke-width: 1.5;
  }
</style>
