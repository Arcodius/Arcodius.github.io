---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "About Me";
const identity = {
	firstName: "Haoran",
	firstNameCHS: "浩然",
	country: "China",
	location: "Los Angeles",
	hobbies: ["PC games", "cycling"],
	languages: ["Chinese Mandarin", "English", "German", "Japanese", "Latin"]
};
const skills = ["C++", "Python"];
const skillColor = "crimson";
---

<BaseLayout pageTitle={pageTitle}>
	<style define:vars={{skillColor}}>
		h1 {
			color: purple;
			font-size: 4rem;
		}
		.skill {
			color: var(--skillColor);
			font-weight: bold;
		}
	</style>
	<h2>... and my site for graphics learning!</h2>
	<p>I am a CS student in USC. I am recently working on fluid simulation as well as rendering techniques. So this website would be my playground for graphics demos and math behind them.</p>

	<p>Here are some facts about me:</p>
	<ul>
		<li>My name is {identity.firstName} ({identity.firstNameCHS}).</li>
		<li>I am from {identity.country} and currently live in {identity.location}.</li>
		{identity.hobbies.length >= 2 && // conditionally render
			<li>Two of my hobbies are: {identity.hobbies[0]} and {identity.hobbies[1]}.</li>
		}
		<li>I can speak and have learned several languages: {identity.languages.join(', ')}.</li>
	</ul>
	<p>My skills include:</p>
	<ul>
		{skills.map((skill) => <li class="skill">{skill}</li>)}
	</ul>
</BaseLayout>

