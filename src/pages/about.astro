---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const skills = ['C++', 'Python', 'OpenGL', 'Numerical Methods'];
const interests = ['Fluid Simulation', 'Rendering', 'Applied Mathematics', 'Cycling'];
---

<BaseLayout title="About" description={`Profile, skills, and research interests of ${site.name}.`}>
  <header class="page-intro about-intro">
    <p class="eyebrow">About / Profile</p>
    <h1>Making interesting things<br />between math and pixels.</h1>
  </header>

  <section class="about-grid">
    <figure class="about-portrait">
      <img src={site.portrait} alt={`Portrait placeholder for ${site.name}`} />
      <figcaption>{site.name} / {site.chineseName}</figcaption>
    </figure>

    <div class="about-copy prose">
      <p>I am a computer science student from China, currently based in Los Angeles. My recent work focuses on fluid simulation and rendering techniques, supported by a growing foundation in applied mathematics.</p>
      <p>This website is my digital workbench: one part project archive, one part record of the ideas and decisions behind each implementation. Away from code, I enjoy PC games, cycling, and learning languages.</p>

      <div class="about-lists">
        <div>
          <h2>Toolkit</h2>
          <ul>{skills.map((skill) => <li>{skill}</li>)}</ul>
        </div>
        <div>
          <h2>Interests</h2>
          <ul>{interests.map((interest) => <li>{interest}</li>)}</ul>
        </div>
      </div>

      <a class="button button-primary" href={`mailto:${site.email}`}>Get in touch <span aria-hidden="true">↗</span></a>
      <p class="small-note">Replace the sample email in <code>src/data/site.ts</code> before publishing.</p>
    </div>
  </section>
</BaseLayout>

