---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import ArrowUpRight from '../../components/ArrowUpRight.astro';
import { formatProjectPeriod } from '../../utils/projects';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const projectPeriod = formatProjectPeriod(project.data);
---

<ContentLayout
  title={project.data.title}
  description={project.data.summary}
  eyebrow="Case study / Demo"
  tags={project.data.tags}
  year={project.data.year}
  period={projectPeriod}
  cover={project.data.cover}
  coverAlt={project.data.coverAlt}
>
  {project.data.links.length > 0 && (
    <div class="project-links">
      {project.data.links.map((link) => (
        <a class="button" href={link.href}>{link.label} <ArrowUpRight /></a>
      ))}
    </div>
  )}
  <Content />
</ContentLayout>
