---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date?: Date;
  eyebrow: string;
  tags?: string[];
  cover?: string;
  coverAlt?: string;
  year?: number;
}

const { title, description, date, eyebrow, tags = [], cover, coverAlt = '', year } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={title} description={description} image={cover}>
  <article class="content-page">
    <header class="content-header">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="content-deck">{description}</p>
      <div class="content-byline">
        {date && <time datetime={date.toISOString()}>{dateFormatter.format(date)}</time>}
        {year && <span>{year}</span>}
        {tags.length > 0 && <span>{tags.join(' · ')}</span>}
      </div>
    </header>

    {cover && (
      <figure class="content-cover">
        <img src={cover} alt={coverAlt} />
      </figure>
    )}

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
